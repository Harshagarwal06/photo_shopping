HF_TOKEN=hf_your_token_here
MODEL_BACKEND=hf
MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
# PLANNER_MODEL_ID=Qwen/Qwen2.5-VL-72B-Instruct
# MATCHER_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
HF_PROVIDER=featherless-ai
LOCAL_VISION_FALLBACK=true

# Initial provider shown in the UI. Both providers remain available in the selector.
GROCERY_PROVIDER=blinkit
INSTAMART_MCP_URL=https://mcp.swiggy.com/im
SWIGGY_OAUTH_BASE_URL=https://mcp.swiggy.com
SWIGGY_REDIRECT_URI=http://localhost:8000/api/providers/instamart/callback

# Start safe. Set false only when you are ready for real cart writes.
DRY_RUN=true
# Independent fail-closed guard. Keep true for testing.
SAFETY_LOCK=true
AUTO_ADD_TO_CART=false
# Each provider requires its own explicit cart-write opt-in.
BLINKIT_CART_WRITES=false
# Separate guard because Instamart update_cart replaces the complete cart.
INSTAMART_CART_WRITES=false
# Checkout/order placement is not implemented and must remain disabled.
CHECKOUT_DISABLED=true
BROWSER_HEADLESS=false
DEMO_MODE=false

# Zepto (Playwright). Its own Chromium profile — cannot share Blinkit's.
ZEPTO_BASE_URL=https://www.zeptonow.com
ZEPTO_PROFILE_DIR=browser_profile_zepto
# Cart writes fail closed. Requires SAFETY_LOCK=false and DRY_RUN=false too.
ZEPTO_CART_WRITES=false

# Comparison tuning
MIN_FILL_RATIO=0.9
MAX_FILL_RATIO=1.1
ETA_TIEBREAK_RUPEES=20
COMPARISON_CONFIRMATION_TTL_SECONDS=300
